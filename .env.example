# Copy this file to .env before the first `docker compose up`:
#
#   cp .env.example .env          (macOS/Linux, or Git Bash on Windows)
#   Copy-Item .env.example .env   (PowerShell)
#
# `docker compose` reads .env automatically. .env itself is git-ignored; this example is not.

# Local SQL Server Express credentials. Throwaway, local-only, never used for Azure.
# Keep this in step with the connection string in InvoicePortal.Admin/appsettings.Development.json,
# which host-side runs use to reach the same container.
MSSQL_SA_PASSWORD=InvPortal!Local2026#Sa
DB_NAME=InvoicePortal

# AI provider for the app container: Mock (offline fake, default) or Ollama (real local model; see README).
AI_PROVIDER=Mock
AI_OLLAMA_ENDPOINT=http://host.docker.internal:11434
AI_OLLAMA_MODEL=qwen2.5-coder:7b

# OpenTelemetry OTLP endpoint for the app container. Empty = export nothing.
# For the local Aspire Dashboard (`docker compose --profile otel up -d`): http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=
# Record SQL statement text on database spans.
TELEMETRY_RECORD_SQL_TEXT=false
