{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal"
      }
    }
  },
  "AppLogging": {
    "RunningInAzure": null,
    "ConsoleEnabled": true,
    "ApplicationInsightsEnabled": true,
    "FilePath": "logs/invoiceportal-.json",
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 14,
    "DatadogEnabled": true
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Enabled": true,
    "OtlpLogsEnabled": true,
    "ServiceName": "InvoicePortal.Admin",
    "OtlpEndpoint": "",
    "OtlpProtocol": "",
    "AzureMonitorConnectionString": "",
    "RecordSqlText": false,
    "RecordAiContent": false,
    "TraceSamplingRatio": 1.0
  },
  "Ai": {
    "Enabled": true,
    "DocumentChatEnabled": true,
    "Provider": "Mock",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "qwen2.5-coder:7b",
      "TimeoutSeconds": 120,
      "ContextLength": 8192
    },
    "AzureOpenAI": {
      "Deployment": "gpt-4.1-mini"
    }
  }
}
