@* Small confirmation dialog body used by every grid's Delete action. *@
<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body1">@Message</RadzenText>
    @if (!string.IsNullOrEmpty(Detail))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            @Detail
        </RadzenAlert>
    }
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="@ConfirmText" ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(() => DialogService.Close(true))" />
    </RadzenStack>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [Parameter] public string Message { get; set; } = "Delete this record?";
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Delete";
}
