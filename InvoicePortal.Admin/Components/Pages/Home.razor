@page "/"
@inject IDbContextFactory<InvoicePortalDbContext> Factory

<PageTitle>Invoice Portal Admin</PageTitle>

<RadzenText TextStyle="TextStyle.H4" Style="color: white;">Invoice Portal Admin</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary rz-mb-4">
    Proof of concept: Blazor + Radzen CRUD over a local SQL Server Express copy of the Invoice Portal database.
</RadzenText>

@if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
        Could not reach the database: @error
    </RadzenAlert>
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (var card in cards)
        {
            <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
                <RadzenLink Path="@card.Path" class="rz-text-decoration-none">
                    <RadzenCard class="rz-p-4">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenIcon Icon="@card.Icon" Style="font-size: 2rem" />
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">@card.Title</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">
                                    @(card.Count.HasValue ? card.Count.Value.ToString("N0") : "…")
                                </RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenLink>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    private sealed class Card(string title, string icon, string path)
    {
        public string Title => title;
        public string Icon => icon;
        public string Path => path;
        public int? Count { get; set; }
    }

    private readonly List<Card> cards =
    [
        new("Invoices", "receipt", "/invoices"),
        new("Bottlers", "factory", "/bottlers"),
        new("Payers", "account_balance", "/payers"),
        new("Sales Centers", "storefront", "/sales-centers"),
        new("Programs", "campaign", "/programs"),
        new("Currencies", "payments", "/currencies"),
    ];

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            cards[0].Count = await db.Invoices.CountAsync(i => !i.IsDeleted);
            cards[1].Count = await db.Bottlers.CountAsync();
            cards[2].Count = await db.Payers.CountAsync();
            cards[3].Count = await db.SalesCenters.CountAsync();
            cards[4].Count = await db.Programs.CountAsync(p => p.IsDeleted != true);
            cards[5].Count = await db.Currencies.CountAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
