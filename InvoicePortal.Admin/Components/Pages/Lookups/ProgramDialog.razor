@inherits EditDialogBase<Program>

<RadzenTemplateForm TItem="Program" Data="@Model" Submit="@(async (Program _) => await Submit())">
    <RadzenStack Gap="1rem">
        @if (Error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@Error</RadzenAlert>
        }
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Program Id (max 16 chars)" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenTextBox Name="Id" @bind-Value="Model.Id" Disabled="@(!IsNew)" MaxLength="16" /></ChildContent>
                    <Helper><RadzenRequiredValidator Component="Id" Text="Program Id is required" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Model.Name" MaxLength="4000" /></ChildContent>
                    <Helper><RadzenRequiredValidator Component="Name" Text="Name is required" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenFormField Text="Bottler" Variant="Variant.Outlined" Style="width: 100%">
            <ChildContent>
                <RadzenDropDown Name="BottlerId" @bind-Value="Model.BottlerId" Data="@bottlers" TextProperty="Text" ValueProperty="Value"
                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
            </ChildContent>
            <Helper><RadzenNumericRangeValidator Component="BottlerId" Min="1" Text="Bottler is required" /></Helper>
        </RadzenFormField>
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="From" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenDatePicker @bind-Value="Model.From" DateFormat="yyyy-MM-dd" ShowTime="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="To" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenDatePicker @bind-Value="Model.To" DateFormat="yyyy-MM-dd" ShowTime="false" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Co-op %" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenNumeric @bind-Value="Model.CoOpPercentage" Min="0" Max="100" Step="0.01" Format="N2" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Co-op amount" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenNumeric @bind-Value="Model.CoOpAmount" Step="0.01" Format="N2" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Amount settled" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenNumeric @bind-Value="Model.AmountSettled" Step="0.01" Format="N2" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Funding element Id" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenNumeric Name="FundingElementId" @bind-Value="Model.FundingElementId" ShowUpDown="false" /></ChildContent>
                    <Helper><RadzenNumericRangeValidator Component="FundingElementId" Min="1" Text="Required (must exist in FundingElements)" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsNew ? "Create" : "Save")" Icon="save" IsBusy="@IsBusy" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private IReadOnlyList<LookupService.Option<int>> bottlers = [];

    protected override Program CreateNew()
    {
        var today = DateTime.UtcNow.Date;
        return new Program
        {
            Id = string.Empty,
            Name = string.Empty,
            From = new DateTime(today.Year, today.Month, 1),
            To = new DateTime(today.Year, today.Month, 1).AddMonths(1).AddDays(-1),
            IsDeleted = false,
        };
    }

    protected override async Task OnModelLoadedAsync() => bottlers = await Lookups.BottlersAsync();

    protected override async Task<string?> ValidateAsync()
    {
        if (Model.To < Model.From)
        {
            return "'To' must be on or after 'From'.";
        }
        if (IsNew && await Service.ExistsAsync(Model.Id.Trim()))
        {
            return $"A program with Id '{Model.Id}' already exists.";
        }
        Model.Id = Model.Id.Trim();
        return null;
    }
}
