@page "/currencies"
@inherits CrudPageBase<Currency, CurrencyDialog>

<PageTitle>Currencies</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-0">Currencies</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@Reload" title="Refresh" />
        <RadzenButton Icon="add" Text="New currency" Click="@Add" />
    </RadzenStack>
</RadzenStack>

<RadzenDataGrid @ref="Grid" TItem="Currency" Data="@Items" Count="@Count" LoadData="@LoadData" IsLoading="@IsLoading"
                AllowFiltering="true" FilterMode="FilterMode.SimpleWithMenu" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowSorting="true" AllowPaging="true" PageSize="20" PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                Density="Density.Compact" EmptyText="No currencies.">
    <Columns>
        <RadzenDataGridColumn TItem="Currency" Property="Id" Title="Id" Width="90px" />
        <RadzenDataGridColumn TItem="Currency" Property="Code" Title="Code" />
        <RadzenDataGridColumn TItem="Currency" Property="CreatedAt" Title="Created (UTC)" FormatString="{0:yyyy-MM-dd HH:mm}" Width="170px" />
        <RadzenDataGridColumn TItem="Currency" Property="UpdatedAt" Title="Updated (UTC)" FormatString="{0:yyyy-MM-dd HH:mm}" Width="170px" />
        <RadzenDataGridColumn TItem="Currency" Filterable="false" Sortable="false" Width="110px" TextAlign="TextAlign.Center">
            <Template Context="row">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(row))" title="Edit" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(() => Delete(row))" title="Delete" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    protected override string EntityName => "Currency";
    protected override object KeyOf(Currency e) => e.Id;
    protected override string Describe(Currency e) => $"currency {e.Code}";
    protected override string DialogWidth => "420px";
}
