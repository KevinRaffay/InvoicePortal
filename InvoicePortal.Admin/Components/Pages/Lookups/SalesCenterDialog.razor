@inherits EditDialogBase<SalesCenter>

<RadzenTemplateForm TItem="SalesCenter" Data="@Model" Submit="@(async (SalesCenter _) => await Submit())">
    <RadzenStack Gap="1rem">
        @if (Error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@Error</RadzenAlert>
        }
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Id (SAP ship-to number)" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenNumeric Name="Id" @bind-Value="Model.Id" Disabled="@(!IsNew)" ShowUpDown="false" /></ChildContent>
                    <Helper>
                        @if (IsNew)
                        {
                            <RadzenNumericRangeValidator Component="Id" Min="1" Text="Id must be a positive number" />
                        }
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Model.Name" MaxLength="128" /></ChildContent>
                    <Helper><RadzenRequiredValidator Component="Name" Text="Name is required" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenFormField Text="Address" Variant="Variant.Outlined" Style="width: 100%">
            <ChildContent><RadzenTextBox Name="Address" @bind-Value="Model.Address" MaxLength="128" /></ChildContent>
            <Helper><RadzenRequiredValidator Component="Address" Text="Address is required" /></Helper>
        </RadzenFormField>
        <RadzenFormField Text="Payer" Variant="Variant.Outlined" Style="width: 100%">
            <ChildContent>
                <RadzenDropDown Name="PayerId" @bind-Value="Model.PayerId" Data="@payers" TextProperty="Text" ValueProperty="Value"
                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowVirtualization="true" />
            </ChildContent>
            <Helper><RadzenNumericRangeValidator Component="PayerId" Min="1" Text="Payer is required" /></Helper>
        </RadzenFormField>
        <div>
            <RadzenCheckBox @bind-Value="Model.IsNonVipShipTo" Name="IsNonVipShipTo" TValue="bool" />
            <RadzenLabel Text="Non-VIP ship-to" Component="IsNonVipShipTo" class="rz-ms-2" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsNew ? "Create" : "Save")" Icon="save" IsBusy="@IsBusy" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private IReadOnlyList<LookupService.Option<int>> payers = [];

    protected override SalesCenter CreateNew() => new() { Name = string.Empty, Address = string.Empty };

    protected override async Task OnModelLoadedAsync() => payers = await Lookups.PayersAsync();

    protected override async Task<string?> ValidateAsync()
    {
        if (IsNew && await Service.ExistsAsync(Model.Id))
        {
            return $"A sales center with Id {Model.Id} already exists.";
        }
        return null;
    }
}
