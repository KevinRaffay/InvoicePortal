@inherits EditDialogBase<Payer>

<RadzenTemplateForm TItem="Payer" Data="@Model" Submit="@(async (Payer _) => await Submit())">
    <RadzenStack Gap="1rem">
        @if (Error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@Error</RadzenAlert>
        }
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Id (SAP payer number)" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenNumeric Name="Id" @bind-Value="Model.Id" Disabled="@(!IsNew)" ShowUpDown="false" /></ChildContent>
                    <Helper>
                        @if (IsNew)
                        {
                            <RadzenNumericRangeValidator Component="Id" Min="1" Text="Id must be a positive number" />
                        }
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Model.Name" MaxLength="128" /></ChildContent>
                    <Helper><RadzenRequiredValidator Component="Name" Text="Name is required" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenFormField Text="Bottler" Variant="Variant.Outlined" Style="width: 100%">
            <ChildContent>
                <RadzenDropDown Name="BottlerId" @bind-Value="Model.BottlerId" Data="@bottlers" TextProperty="Text" ValueProperty="Value"
                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
            </ChildContent>
            <Helper><RadzenNumericRangeValidator Component="BottlerId" Min="1" Text="Bottler is required" /></Helper>
        </RadzenFormField>
        <RadzenFormField Text="Address" Variant="Variant.Outlined" Style="width: 100%">
            <RadzenTextBox @bind-Value="Model.Address" MaxLength="128" />
        </RadzenFormField>
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="City" Variant="Variant.Outlined" Style="width: 100%"><RadzenTextBox @bind-Value="Model.City" MaxLength="128" /></RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeMD="3">
                <RadzenFormField Text="State" Variant="Variant.Outlined" Style="width: 100%"><RadzenTextBox @bind-Value="Model.State" MaxLength="5" /></RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeMD="3">
                <RadzenFormField Text="Zip" Variant="Variant.Outlined" Style="width: 100%"><RadzenTextBox @bind-Value="Model.ZipCode" MaxLength="16" /></RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Vendor Id" Variant="Variant.Outlined" Style="width: 100%"><RadzenNumeric @bind-Value="Model.VendorId" ShowUpDown="false" Placeholder="(none)" /></RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Statement contact Id" Variant="Variant.Outlined" Style="width: 100%"><RadzenNumeric @bind-Value="Model.StatementContactId" ShowUpDown="false" Placeholder="(none)" /></RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCheckBox @bind-Value="doNotUse" Name="DoNotUse" TValue="bool" />
                <RadzenLabel Text="Do not use" Component="DoNotUse" class="rz-ms-2" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsNew ? "Create" : "Save")" Icon="save" IsBusy="@IsBusy" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private IReadOnlyList<LookupService.Option<int>> bottlers = [];

    private bool doNotUse
    {
        get => Model.DoNotUse == true;
        set => Model.DoNotUse = value;
    }

    protected override Payer CreateNew() => new()
    {
        Name = string.Empty, Address = string.Empty, City = string.Empty, State = string.Empty, ZipCode = string.Empty, DoNotUse = false,
    };

    protected override async Task OnModelLoadedAsync() => bottlers = await Lookups.BottlersAsync();

    protected override async Task<string?> ValidateAsync()
    {
        if (IsNew && await Service.ExistsAsync(Model.Id))
        {
            return $"A payer with Id {Model.Id} already exists.";
        }
        return null;
    }
}
