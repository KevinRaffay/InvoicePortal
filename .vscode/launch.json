{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs the app on the host against the SQL Server container, so breakpoints work.
      // Start the database first: task "compose: up (sql only)".
      // The connection string comes from appsettings.Development.json (localhost,1433).
      "name": "Admin (host, debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/InvoicePortal.Admin/bin/Debug/net10.0/InvoicePortal.Admin.dll",
      "cwd": "${workspaceFolder}/InvoicePortal.Admin",
      "stopAtEntry": false,
      "console": "internalConsole",
      // Serilog writes compact JSON, so the URL arrives as \"http://...\" - the pattern
      // allows the escaped quote. A plain \S+ capture would swallow the trailing \".
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+\\\\?\"?(https?://[^\\s\"\\\\]+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5098"
      }
    },
    {
      // Same, but exports traces/metrics/logs to the Aspire Dashboard.
      // Start it first: docker compose --profile otel up -d aspire-dashboard
      "name": "Admin (host, debug + OpenTelemetry)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/InvoicePortal.Admin/bin/Debug/net10.0/InvoicePortal.Admin.dll",
      "cwd": "${workspaceFolder}/InvoicePortal.Admin",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+\\\\?\"?(https?://[^\\s\"\\\\]+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5098",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:18889"
      }
    }
  ]
}
